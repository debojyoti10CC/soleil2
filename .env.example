# Local presentation listens only on loopback. Real public TESTNET assets only.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3001
ALLOW_DEMO=true
DATABASE_PATH=./data/soleil.sqlite
SOLEIL_NATIVE_ENABLED=true
SOLEIL_NATIVE_DIRECTORY=./data/native-tempo
# Run npm run presentation:prepare once before opening the presentation.
# Optional accounting simulation remains explicitly separate.

# Public test-network configuration; do not put private keys in VITE_ variables.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_MINT=
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_VAULT_ADDRESS=
TEMPO_TOKEN_ADDRESS=

# Commercial integrations remain disabled until credentials and routes are approved.
# Bridge credentials are server-only; never expose them in the browser bundle.
BRIDGE_API_KEY=
BRIDGE_API_BASE=https://api.sandbox.bridge.xyz
